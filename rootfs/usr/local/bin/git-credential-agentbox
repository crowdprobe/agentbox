#!/usr/bin/env bash
#
# git credential helper (enabled in /etc/gitconfig for https://github.com):
# answers with a GitHub App token from agentbox-gh-token when an App is
# mounted, and stays silent otherwise, so other credentials still work.
set -uo pipefail

[[ "${1:-}" == get ]] || exit 0
while IFS= read -r line && [[ -n "$line" ]]; do :; done
[[ -e /run/secrets/agentbox-gh-app ]] || exit 0

token="$(agentbox-gh-token 2>/dev/null)" || exit 0
[[ -n "$token" ]] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
